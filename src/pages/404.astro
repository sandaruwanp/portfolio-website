---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro";

const links = [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
    { href: "/blog", label: "Blog" },
];
---

<BaseLayoutAstroComponent
    title="404 — Sandaruwan Pathirana"
    description="Page not found."
>
    <div class="content-width page" role="alert">
        <div class="prose">
            <h1>404</h1>
            <p>The page you requested could not be found.</p>
            <span class="gold-bar" aria-hidden="true"></span>
            <ul>
                {
                    links.map((link) => (
                        <li>
                            <a href={link.href}>&rarr; {link.label}</a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</BaseLayoutAstroComponent>

<style>
    .page {
        padding-top: var(--space-3xl);
    }

    h1 {
        font-family: var(--serif);
        font-size: var(--text-h1);
        font-weight: 600;
        color: var(--text);
    }

    p {
        font-family: var(--serif);
        font-size: var(--text-body);
        color: var(--text-ter);
        margin-top: var(--space-sm);
    }

    .gold-bar {
        display: block;
        width: 24px;
        height: 1px;
        background: var(--accent-gold);
        margin: var(--space-lg) 0;
    }

    ul {
        list-style: none;
    }

    li + li {
        margin-top: var(--space-sm);
    }

    a {
        font-family: var(--mono);
        font-size: var(--text-body);
        color: var(--text);
        text-decoration: none;
    }

    a:hover {
        color: var(--accent);
    }
</style>
