---
import { getCollection, render } from "astro:content";
import BaseLayoutAstroComponent from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag/Tag.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayoutAstroComponent
    title={project.data.title}
    description={project.data.description}
>
    <div class="content-width page">
        <div class="prose">
            <nav aria-label="Back navigation">
                <a href="/projects">&larr; Back to Projects</a>
            </nav>
            <article>
                <h1>{project.data.title}</h1>

                <div class="meta">
                    <ul class="tags">
                        {project.data.tags.map((tag) => <Tag label={tag} />)}
                    </ul>

                    <a class="repo-link" href={project.data.link} target="_blank" rel="noopener noreferrer">
                        View on GitHub &rarr;
                    </a>
                </div>

                <p class="description">{project.data.description}</p>

                <div class="body">
                    <Content />
                </div>
            </article>
        </div>
    </div>
</BaseLayoutAstroComponent>

<style>
    .page {
        padding-top: var(--space-xl);
    }

    nav a {
        font-family: var(--mono);
        font-size: var(--text-small);
        color: var(--accent);
        text-decoration: none;
    }

    h1 {
        font-family: var(--serif);
        font-size: var(--text-h1);
        font-weight: 600;
        margin-top: var(--space-lg);
    }

    .meta {
        margin-top: var(--space-sm);
    }

    .description {
        font-family: var(--serif);
        font-size: var(--text-h3);
        font-weight: 400;
        color: var(--text-sec);
        line-height: 1.5;
        margin-top: var(--space-xl);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
    }

    .repo-link {
        display: inline-block;
        font-family: var(--mono);
        font-size: var(--text-small);
        color: var(--accent);
        text-decoration: none;
        margin-top: var(--space-sm);
    }

    .body {
        margin-top: var(--space-xl);
        font-family: var(--serif);
        color: var(--text-sec);
        line-height: 1.618;
    }

    .body :global(h2) {
        font-family: var(--serif);
        font-size: var(--text-h2);
        font-weight: 600;
        color: var(--text);
        border-bottom: 1px solid var(--border-light);
        padding-bottom: 2px;
        margin-top: var(--space-lg);
    }

    .body :global(p) {
        margin-top: var(--space-md);
    }

    .body :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .body :global(a:hover) {
        color: var(--accent-hover);
    }

    .body :global(strong) {
        font-weight: 700;
        color: var(--text);
    }

    .body :global(ul),
    .body :global(ol) {
        margin-top: var(--space-md);
        padding-left: var(--space-base);
    }

    .body :global(li + li) {
        margin-top: var(--space-xs);
    }

    .body :global(blockquote) {
        border-left: 2px solid var(--accent);
        padding-left: var(--space-base);
        margin-top: var(--space-md);
        font-style: italic;
    }

    .body :global(code) {
        font-family: var(--mono);
        font-size: var(--text-small);
        background: var(--surface-alt);
        padding: 1px 5px;
        border-radius: 2px;
    }

    .body :global(pre code) {
        background: none;
        padding: 0;
        border-radius: 0;
    }
</style>
