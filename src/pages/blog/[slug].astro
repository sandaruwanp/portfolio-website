---
import { getCollection, render } from "astro:content";
import BaseLayoutAstroComponent from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag/Tag.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayoutAstroComponent
    title={post.data.title}
    description={post.data.description}
>
    <div class="content-width page">
        <div class="prose">
            <nav aria-label="Back navigation">
                <a href="/blog">&larr; Back to Blog</a>
            </nav>
            <article>
                <h1>{post.data.title}</h1>
                <div class="meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })}
                    </time>
                    {post.data.readingTime && <span>{post.data.readingTime}</span>}
                </div>

                {
                    post.data.tags && (
                        <ul class="tags">
                            {post.data.tags.map((tag) => (
                                <Tag label={tag} />
                            ))}
                        </ul>
                    )
                }

                <div class="body">
                    <Content />
                </div>
            </article>
        </div>
    </div>
</BaseLayoutAstroComponent>

<style>
    .page {
        padding-top: var(--space-xl);
    }

    nav a {
        font-family: var(--mono);
        font-size: var(--text-small);
        color: var(--accent);
        text-decoration: none;
    }

    h1 {
        font-family: var(--serif);
        font-size: var(--text-h1);
        font-weight: 600;
        margin-top: var(--space-lg);
    }

    .meta {
        display: flex;
        gap: var(--space-sm);
        font-family: var(--mono);
        font-size: var(--text-xs);
        color: var(--text-ter);
        margin-top: var(--space-sm);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-top: var(--space-base);
    }

    .body {
        margin-top: var(--space-xl);
        font-family: var(--serif);
        color: var(--text-sec);
        line-height: 1.618;
    }

    .body :global(h2) {
        font-family: var(--serif);
        font-size: var(--text-h2);
        font-weight: 600;
        color: var(--text);
        border-bottom: 1px solid var(--border-light);
        padding-bottom: 2px;
        margin-top: var(--space-lg);
    }

    .body :global(p) {
        margin-top: var(--space-md);
    }

    .body :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .body :global(a:hover) {
        color: var(--accent-hover);
    }

    .body :global(strong) {
        font-weight: 700;
        color: var(--text);
    }

    .body :global(ul),
    .body :global(ol) {
        margin-top: var(--space-md);
        padding-left: var(--space-base);
    }

    .body :global(li + li) {
        margin-top: var(--space-xs);
    }

    .body :global(blockquote) {
        border-left: 2px solid var(--accent);
        padding-left: var(--space-base);
        margin-top: var(--space-md);
        font-style: italic;
    }

    .body :global(code) {
        font-family: var(--mono);
        font-size: var(--text-small);
        background: var(--surface-alt);
        padding: 1px 5px;
        border-radius: 2px;
    }

    .body :global(pre code) {
        background: none;
        padding: 0;
        border-radius: 0;
    }
</style>
