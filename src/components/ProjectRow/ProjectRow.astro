---
import Tag from "../Tag/Tag.astro";
import { toRoman } from "../../utils/roman";

interface Props {
    index: number;
    title: string;
    slug: string;
    tags: string[];
}

const { index, title, slug, tags } = Astro.props;
---

<li class="project-row">
    <div class="row-head">
        <span class="numeral">{toRoman(index)}</span>
        <a href={`/projects/${slug}`} class="title">{title}</a>
        <span class="leader" aria-hidden="true"></span>
    </div>
    <ul class="tags">
        {tags.map((tag) => <Tag label={tag} />)}
    </ul>
</li>

<style>
    .project-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        column-gap: var(--space-sm);
        row-gap: var(--space-xs);
        padding: var(--space-sm) 0;
        border-bottom: 1px solid var(--border-light);
        list-style: none;
    }

    .row-head {
        display: flex;
        align-items: baseline;
        gap: var(--space-sm);
        flex: 1 1 auto;
        min-width: 0;
    }

    .numeral {
        font-family: var(--serif);
        font-style: italic;
        font-size: var(--text-small);
        color: var(--accent-gold);
        width: 24px;
        flex-shrink: 0;
    }

    .title {
        font-family: var(--serif);
        font-size: var(--text-h3);
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        transition: color var(--transition-fast);
        flex: 1 1 auto;
        min-width: 0;
    }

    .title:hover {
        color: var(--accent);
    }

    .leader {
        flex: 1 1 20px;
        min-width: 20px;
        border-bottom: 1px dotted var(--border);
        align-self: center;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        flex: 0 0 auto;
    }
</style>
