---
---

<section class="hero">
    <h1>Sandaruwan Pathirana</h1>
    <span class="gold-bar" aria-hidden="true"></span>
    <p class="tagline">
        Building secure systems, reliable infrastructure, and performant
        software.
    </p>
    <ul class="focus-areas">
        <li>Networking</li>
        <li>Linux</li>
        <li>Backend</li>
        <li>Cloud</li>
        <li>Security</li>
    </ul>
</section>

<style>
    .hero {
        padding-top: var(--space-3xl);
        padding-inline: var(--space-base);
        text-align: center;
    }

    h1 {
        font-family: var(--serif);
        font-size: var(--text-display);
        font-weight: 600;
        line-height: 1.06;
        color: var(--text);
    }

    .gold-bar {
        display: block;
        width: 32px;
        height: 1px;
        background: var(--accent-gold);
        margin: var(--space-base) auto;
    }

    .tagline {
        font-family: var(--serif);
        font-size: var(--text-h3);
        font-weight: 400;
        color: var(--text-sec);
        max-width: 32rem;
        margin-inline: auto;
    }

    .focus-areas {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-base);
        margin-top: var(--space-lg);
    }

    .focus-areas li {
        font-family: var(--mono);
        font-size: var(--text-xs);
        color: var(--text-sec);
        border-left: 1px solid var(--accent-gold);
        padding-left: var(--space-sm);
        text-align: left;
    }
</style>
